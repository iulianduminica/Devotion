{
  "name": "devotion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local-first Notion alternative: block editor, relational databases, eight views, and pluggable on-device AI. One SQLite file, one process, no cloud.",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/iulianduminica/Devotion",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iulianduminica/Devotion.git"
  },
  "bugs": {
    "url": "https://github.com/iulianduminica/Devotion/issues"
  },
  "keywords": [
    "local-first",
    "notes",
    "block-editor",
    "notion-alternative",
    "sqlite",
    "ollama",
    "self-hosted",
    "offline"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "server": "tsx watch server/index.ts",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seed.ts",
    "licenses": "node scripts/licenses.mjs --direct",
    "boot:check": "node scripts/boot-check.mjs",
    "test": "tsx scripts/test.ts",
    "test:databases": "tsx scripts/test-databases.ts",
    "test:formula": "tsx scripts/test-formula.ts",
    "test:port": "tsx scripts/test-port.ts",
    "test:ai": "tsx scripts/test-ai.ts",
    "test:views": "tsx scripts/test-views.ts",
    "test:columns": "tsx scripts/test-columns.ts",
    "test:smoke": "tsx scripts/smoke.ts",
    "test:all": "tsx scripts/test.ts && tsx scripts/test-databases.ts && tsx scripts/test-formula.ts && tsx scripts/test-port.ts && tsx scripts/test-ai.ts && tsx scripts/test-views.ts && tsx scripts/test-columns.ts && tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@blocknote/core": "^0.57.0",
    "@blocknote/mantine": "^0.57.0",
    "@blocknote/react": "^0.57.0",
    "@fastify/static": "^10.1.12",
    "@mantine/core": "^9.8.2",
    "@mantine/hooks": "^9.8.2",
    "@tailwindcss/vite": "^4.3.5",
    "date-fns": "^4.4.0",
    "fastify": "^5.12.8",
    "katex": "^0.19.1",
    "lucide-react": "^1.79.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  }
}
